---
import { SOCIAL } from "../data/config";

const getCollabLink = () => {
  const text = encodeURIComponent(
    "Hola, vi la campaña Rumbo a España 2026 y me gustaría colaborar con mi comercio/emprendimiento.",
  );

  const baseUrl = SOCIAL.whatsapp.includes("wa.me")
    ? SOCIAL.whatsapp.replace(/\/$/, "")
    : "https://wa.me/5490000000000";

  return `${baseUrl}?text=${text}`;
};
---

<section id="colaboraciones-comerciales" class="px-5 py-[88px]">
  <div class="mx-auto max-w-[1000px]">
    <div
      class="rounded-brand border border-border bg-card p-6 shadow-card sm:p-10 lg:p-12"
    >
      <div class="text-center">
        <span
          class="mb-3.5 inline-flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.14em] text-primary"
        >
          <span class="h-0.5 w-[22px] bg-primary"></span>
          Alianzas Comerciales
        </span>

        <h2
          class="mb-3.5 font-display text-[clamp(28px,6vw,42px)] leading-[1.05] tracking-[-0.01em] text-foreground"
        >
          ¿Tenés un comercio o emprendimiento?
        </h2>

        <p
          class="mx-auto mb-10 max-w-[650px] text-base leading-relaxed text-foreground-muted"
        >
          Podés acompañarnos rumbo a España y, al mismo tiempo, encontrar una
          forma de colaborar con alguno de nuestros proyectos.
        </p>
      </div>

      <div class="mb-10 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <article
          class="rounded-brand-sm border border-border bg-white/[0.025] p-5 transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-white/[0.16]"
        >
          <div class="mb-3 text-[1.75rem] leading-none">🤝</div>

          <h3 class="mb-2 font-display text-lg text-foreground">
            Sponsorizar
          </h3>

          <p class="text-sm leading-relaxed text-foreground-muted">
            Elegí entre los niveles de $50.000, $100.000 o $150.000 con
            presencia web y en redes.
          </p>
        </article>

        <article
          class="rounded-brand-sm border border-border bg-white/[0.025] p-5 transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-white/[0.16]"
        >
          <div class="mb-3 text-[1.75rem] leading-none">💼</div>

          <h3 class="mb-2 font-display text-lg text-foreground">
            Contratar un servicio
          </h3>

          <p class="text-sm leading-relaxed text-foreground-muted">
            Soluciones con AIM, desarrollo a medida, consultoría IT, HES1994 o
            Scalinky.
          </p>
        </article>

        <article
          class="rounded-brand-sm border border-border bg-white/[0.025] p-5 transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-white/[0.16]"
        >
          <div class="mb-3 text-[1.75rem] leading-none">🔄</div>

          <h3 class="mb-2 font-display text-lg text-foreground">
            Hacer una colaboración
          </h3>

          <p class="text-sm leading-relaxed text-foreground-muted">
            Intercambio de productos o servicios, difusión conjunta, sorteos o
            eventos especiales.
          </p>
        </article>
      </div>

      <div class="text-center">
        <a
          href={getCollabLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-3.5 text-sm font-bold text-white shadow-[0_8px_24px_rgba(224,30,43,0.3)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-[0_10px_30px_rgba(224,30,43,0.45)] active:scale-[0.97]"
        >
          Quiero colaborar
        </a>
      </div>
    </div>
  </div>
</section>