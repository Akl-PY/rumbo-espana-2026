---
const EXPENSES = [
  { icon: "✈️", title: "Pasajes aéreos", desc: "Vuelos ida y vuelta hacia España para competidores y coaches." },
  { icon: "🏨", title: "Alojamiento oficial", desc: "Estadía durante los días reglamentarios del certamen en Benidorm." },
  { icon: "🥋", title: "Inscripciones y licencias", desc: "Acreditación oficial a la Copa del Mundo y seguros deportivos." },
  { icon: "🚕", title: "Traslados internos", desc: "Movilidad aeropuerto-hotel-estadio y logística de la delegación." },
  { icon: "🍽️", title: "Nutrición y gastos de viaje", desc: "Alimentación deportiva, pesaje e hidratación durante la competencia." },
];
---

<section id="transparencia" class="section transparency-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge">Claridad y Compromiso</span>
      <h2 class="section-title">¿A dónde va nuestro objetivo?</h2>
      <p class="section-subtitle">
        Cada aporte de la comunidad y de los sponsors se destina exclusivamente a hacer viable la participación en la Copa del Mundo.
      </p>
    </div>

    <div class="expenses-grid">
      {EXPENSES.map((item) => (
        <div class="expense-card">
          <span class="expense-icon">{item.icon}</span>
          <h3 class="expense-title">{item.title}</h3>
          <p class="expense-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .transparency-section {
    padding: 4.5rem 1rem;
    background: #0f172a;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .text-center {
    text-align: center;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: #fff;
  }

  .section-subtitle {
    color: #94a3b8;
    max-width: 600px;
    margin: 0 auto 3rem;
    font-size: 1.05rem;
  }

  .expenses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .expense-card {
    background: #111827;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.85rem;
    padding: 1.5rem;
    text-align: left;
  }

  .expense-icon {
    font-size: 2rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .expense-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 0.4rem;
  }

  .expense-desc {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.4;
    margin: 0;
  }
</style>
