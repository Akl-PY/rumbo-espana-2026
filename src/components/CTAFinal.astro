---
import { ALIAS } from "../data/config";
---

<section class="cta-final">
  <div class="container">
    <h2 class="reveal">AYUDANOS A LLEGAR</h2>
    <p class="reveal">Cada aporte nos acerca un poco más a Benidorm.</p>

    <div class="cta-alias reveal">{ALIAS}</div>
    <div class="reveal">
      <button class="btn btn-primary js-copy-alias" data-alias={ALIAS}>
        Copiar alias
      </button>
    </div>
  </div>
</section>

