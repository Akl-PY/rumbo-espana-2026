---
import { SPONSORS } from '../data/sponsors';
---

<section id="sponsors-actuales" class="border-y border-border px-5 py-[88px]">
  <div class="mx-auto max-w-[1100px]">
    <!-- Header -->
    <div class="mb-10 text-center">
      <span class="mb-3.5 inline-flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.14em] text-primary">
        <span class="h-0.5 w-[22px] bg-primary"></span>
        Alianzas
      </span>
      <h2 class="mb-3.5 font-display text-[clamp(28px,6vw,42px)] leading-[1.05] tracking-[-0.01em] text-foreground">
        Ellos ya son parte del viaje
      </h2>
      <p class="mx-auto max-w-[560px] text-base leading-relaxed text-foreground-muted">
        Agradecemos a los comercios y marcas que confían y apuestan por nuestra
        delegación rumbo a Benidorm 2026.
      </p>
    </div>

    <!-- Sponsors Grid -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {SPONSORS.map((sponsor) => {
        const tierClasses =
          sponsor.level === 'oro'
            ? 'border-yellow-500/20 hover:border-yellow-400/60'
            : sponsor.level === 'plata'
              ? 'border-slate-400/20 hover:border-slate-300/60'
              : sponsor.level === 'bronce'
                ? 'border-orange-700/20 hover:border-orange-500/60'
                : 'border-border hover:border-white/20';

        const badgeClasses =
          sponsor.level === 'oro'
            ? 'border-yellow-500/40 bg-yellow-500/10 text-yellow-400'
            : sponsor.level === 'plata'
              ? 'border-slate-400/40 bg-slate-400/10 text-slate-300'
              : sponsor.level === 'bronce'
                ? 'border-orange-500/40 bg-orange-500/10 text-orange-400'
                : 'border-border bg-white/5 text-foreground-muted';

        return (
          <a
            href={sponsor.url || '#'}
            target={sponsor.url && sponsor.url !== '#' ? '_blank' : '_self'}
            rel="noopener noreferrer"
            title={`${sponsor.name} - Sponsor ${sponsor.level.toUpperCase()}`}
            class={`group relative flex min-h-[210px] flex-col items-center justify-between overflow-hidden rounded-brand border bg-card px-4 py-6 text-center shadow-card transition-all duration-300 ease-brand hover:-translate-y-1 hover:shadow-card-lg ${tierClasses}`}
          >
            <!-- Glow sutil del nivel -->
            <div
              class={`pointer-events-none absolute -right-10 -top-10 h-24 w-24 rounded-full blur-3xl opacity-0 transition-opacity duration-300 group-hover:opacity-100 ${
                sponsor.level === 'oro'
                  ? 'bg-yellow-400/10'
                  : sponsor.level === 'plata'
                    ? 'bg-slate-300/10'
                    : sponsor.level === 'bronce'
                      ? 'bg-orange-500/10'
                      : 'bg-primary/10'
              }`}
            ></div>

            <!-- Logo con ancho adaptativo -->
            <div class="relative flex h-[85px] max-w-full items-center justify-center rounded-brand-sm border border-white/[0.06] bg-background-soft/70 px-4">
              {sponsor.logo ? (
                <img
                  src={sponsor.logo}
                  alt={`Logo de ${sponsor.name}`}
                  loading="lazy"
                  class="max-h-[60px] w-auto max-w-full object-contain opacity-90 transition-all duration-300 group-hover:scale-[1.03] group-hover:opacity-100"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
              ) : null}

              <!-- Fallback -->
              <div
                class={`h-[65px] w-[65px] flex-col items-center justify-center rounded-full border border-border bg-card ${sponsor.logo ? 'hidden' : 'flex'}`}
              >
                <span class="font-display text-xl leading-none text-foreground-muted">
                  {sponsor.name.charAt(0)}
                </span>
                <span class="mt-1 max-w-[50px] overflow-hidden text-ellipsis whitespace-nowrap text-[9px] text-foreground-muted">
                  {sponsor.name}
                </span>
              </div>
            </div>

            <!-- Información y Descripción -->
            <div class="relative w-full mt-3">
              <span class="mb-1 block text-sm font-bold text-foreground">
                {sponsor.name}
              </span>

              {sponsor.description && (
                <p class="mb-2 text-[11px] leading-tight text-foreground-muted line-clamp-2">
                  {sponsor.description}
                </p>
              )}

              <span
                class={`inline-block rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.05em] ${badgeClasses}`}
              >
                {sponsor.level}
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
