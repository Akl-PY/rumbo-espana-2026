---
import { donations } from "../data/donations";

function formatARS(n: number) {
  return new Intl.NumberFormat("es-AR", {
    maximumFractionDigits: 0,
  }).format(n);
}

const sorted = [...donations].sort((a, b) => b.amount - a.amount);
---

<section id="donaciones" class="px-5 py-[88px]">
  <div class="mx-auto max-w-[1100px]">
    <span
      class="mb-3.5 inline-flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.14em] text-primary"
    >
      <span class="h-0.5 w-[22px] bg-primary"></span>
      Gracias
    </span>

    <h2
      class="mb-3.5 font-display text-[clamp(28px,6vw,42px)] leading-[1.05] tracking-[-0.01em] text-foreground"
    >
      Quienes ya nos ayudaron
    </h2>

    <p class="mb-10 max-w-[560px] text-base leading-relaxed text-foreground-muted">
      Cada aporte, grande o chico, nos acerca un poco más a Benidorm.
    </p>

    {
      sorted.length === 0 ? (
        <div class="flex flex-col gap-2 rounded-brand border border-border bg-card p-6 shadow-card">
          <strong class="font-display text-lg text-foreground">
            Todavía no hay donaciones cargadas
          </strong>

          <span class="text-sm text-foreground-muted">
            Sé la primera o el primero en ayudarnos a llegar. 🇦🇷
          </span>
        </div>
      ) : (
        <div class="space-y-3">
          {sorted.map((d) => (
            <article class="flex flex-col gap-4 rounded-brand border border-border bg-card p-5 shadow-card transition-all duration-300 ease-brand hover:-translate-y-0.5 hover:border-white/[0.18] sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <div class="font-bold text-foreground">
                  {d.name}
                </div>

                {d.message && (
                  <div class="mt-1 text-sm italic leading-relaxed text-foreground-muted">
                    "{d.message}"
                  </div>
                )}
              </div>

              <div class="shrink-0 font-display text-xl text-primary">
                ${formatARS(d.amount)}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>