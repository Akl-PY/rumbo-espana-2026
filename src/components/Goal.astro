---
import { GOAL, RAISED } from "../data/config";
import { donations } from "../data/donations";
import { SPONSORS } from "../data/sponsors";

// 1. Total de donaciones particulares
const donationsTotalFromList = donations.reduce((acc, curr) => acc + (curr.amount || 0), 0);
const totalDonations = RAISED > 0 ? RAISED : donationsTotalFromList;

// 2. Total aportado por sponsors
const totalSponsors = SPONSORS.reduce((acc, curr) => acc + (curr.amount || 0), 0);

// 3. Monto global unificado y porcentaje
const totalRaised = totalDonations + totalSponsors;
const progressPercent = Math.min(100, Math.round((totalRaised / GOAL) * 100));

const formatCurrency = (val: number) => {
  return new Intl.NumberFormat("es-AR", {
    style: "currency",
    currency: "ARS",
    maximumFractionDigits: 0,
  }).format(val);
};
---

<section id="objetivo" class="section goal-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge">Transparencia y Meta</span>
      <h2 class="section-title">Nuestro Objetivo</h2>
      <p class="section-subtitle">
        El viaje a la Copa del Mundo en Benidorm se financia gracias al apoyo de nuestra comunidad y las marcas aliadas.
      </p>
    </div>

    <div class="goal-card">
      <div class="goal-header">
        <div class="goal-amount">
          <span class="label">Meta final</span>
          <span class="val highlight">{formatCurrency(GOAL)}</span>
        </div>
        <div class="goal-percentage">
          <span class="pct">{progressPercent}%</span>
          <span class="pct-label">alcanzado</span>
        </div>
      </div>

      <!-- Barra de progreso -->
      <div class="progress-wrapper">
        <div 
          class="progress-bar" 
          role="progressbar" 
          aria-valuenow={progressPercent} 
          aria-valuemin="0" 
          aria-valuemax="100"
          style={`width: ${progressPercent}%;`}
        >
        </div>
      </div>

      <div class="goal-breakdown-grid">
        <div class="breakdown-item total">
          <span class="breakdown-label">Total Recaudado</span>
          <span class="breakdown-value">{formatCurrency(totalRaised)}</span>
        </div>

        <div class="breakdown-item">
          <span class="breakdown-label">❤️ Donaciones</span>
          <span class="breakdown-value">{formatCurrency(totalDonations)}</span>
          <span class="breakdown-sub">{donations.length} aportes</span>
        </div>

        <div class="breakdown-item">
          <span class="breakdown-label">🤝 Sponsors</span>
          <span class="breakdown-value">{formatCurrency(totalSponsors)}</span>
          <span class="breakdown-sub">{SPONSORS.length} marcas</span>
        </div>
      </div>

      <div class="goal-footer">
        <p>
          Meta fijada para pasajes, alojamiento, inscripciones y traslados de los 3 competidores y 2 coaches.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .goal-section {
    padding: 4rem 1rem;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .text-center {
    text-align: center;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: #fff;
  }

  .section-subtitle {
    color: #94a3b8;
    max-width: 600px;
    margin: 0 auto 2.5rem;
    font-size: 1.05rem;
  }

  .goal-card {
    background: #111827;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .goal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.25rem;
  }

  .goal-amount .label {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    color: #94a3b8;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .goal-amount .val {
    font-size: 2.2rem;
    font-weight: 800;
    color: #38bdf8;
    line-height: 1;
  }

  .goal-percentage {
    text-align: right;
  }

  .goal-percentage .pct {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #f59e0b;
    line-height: 1;
  }

  .goal-percentage .pct-label {
    font-size: 0.8rem;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .progress-wrapper {
    width: 100%;
    height: 18px;
    background: #1f2937;
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6 0%, #06b6d4 50%, #10b981 100%);
    border-radius: 9999px;
    transition: width 0.6s ease-in-out;
  }

  .goal-breakdown-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .breakdown-item {
    background: #1e293b;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .breakdown-item.total {
    border-left: 4px solid #38bdf8;
  }

  .breakdown-label {
    display: block;
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 0.25rem;
  }

  .breakdown-value {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .breakdown-sub {
    font-size: 0.75rem;
    color: #64748b;
  }

  .goal-footer {
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.25rem;
  }

  .goal-footer p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  @media (max-width: 640px) {
    .goal-card {
      padding: 1.25rem;
    }
    .goal-amount .val {
      font-size: 1.75rem;
    }
    .goal-percentage .pct {
      font-size: 1.6rem;
    }
  }
</style>
