---
import helpData from '../data/how-to-help.json';

const items = helpData.items ?? [];

const iconPaths = {
  heart: `
    <path d="M20.8 8.7C20.8 13.2 12 19 12 19S3.2 13.2 3.2 8.7C3.2 6.1 5.2 4.2 7.7 4.2C9.3 4.2 10.9 5 12 6.3C13.1 5 14.7 4.2 16.3 4.2C18.8 4.2 20.8 6.1 20.8 8.7Z"/>
  `,
  handshake: `
    <path d="M4 8.5L7 6H10.5L12 7.5L13.5 6H17L20 8.5L17.5 11L15.5 9.5"/>
    <path d="M4 8.5L2.5 10L6.5 14L9 11.5"/>
    <path d="M20 8.5L21.5 10L17.5 14L15 11.5"/>
    <path d="M8 13L10 15C11 16 12.5 16 13.5 15L16 12.5"/>
  `,
  briefcase: `
    <rect x="3" y="7" width="18" height="13" rx="2"/>
    <path d="M8 7V5C8 3.9 8.9 3 10 3H14C15.1 3 16 3.9 16 5V7"/>
    <path d="M3 12H21"/>
  `,
  megaphone: `
    <path d="M4 13V8L15 4V17L4 13Z"/>
    <path d="M15 8L20 6V15L15 13"/>
    <path d="M7 14L8.5 19"/>
  `,
} as const;

const getShareText = () => {
  return encodeURIComponent(
    '¡Hola! Te comparto la campaña Rumbo a España 2026 de nuestra delegación de Taekwondo. Podés sumar tu apoyo o compartirla.',
  );
};
---

<section id="como-ayudar" class="relative px-5 py-[88px]">
  <div class="mx-auto max-w-[1100px]">
    <!-- Header -->
    <div class="mx-auto mb-12 max-w-[700px] text-center">
      <span class="mb-3.5 inline-flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.14em] text-primary">
        <span class="h-0.5 w-[22px] bg-primary"></span>
        {helpData.eyebrow}
      </span>

      <h2 class="mb-4 font-display text-[clamp(30px,6vw,46px)] leading-[1.02] tracking-[-0.015em] text-foreground">
        {helpData.title}
      </h2>

      <p class="mx-auto max-w-[620px] text-base leading-[1.75] text-foreground-muted">
        {helpData.description}
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {items.map((item, index) => {
        const isPrimary = item.id === 'donar';
        const isSponsor = item.id === 'sponsor';

        return (
          <article
            class:list={[
              'group relative flex flex-col overflow-hidden rounded-[24px] border bg-card p-6 shadow-card transition-all duration-300 ease-brand sm:p-7',
              'hover:-translate-y-1 hover:shadow-card-lg',
              isPrimary
                ? 'border-primary/35 bg-primary/[0.035] hover:border-primary/60'
                : isSponsor
                  ? 'border-yellow-400/25 hover:border-yellow-400/50'
                  : 'border-border hover:border-white/[0.18]',
            ]}
          >
            <!-- Glow -->
            <div
              class:list={[
                'pointer-events-none absolute -right-20 -top-20 h-44 w-44 rounded-full blur-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100',
                isPrimary
                  ? 'bg-primary/10'
                  : isSponsor
                    ? 'bg-yellow-400/[0.08]'
                    : 'bg-white/[0.04]',
              ]}
            ></div>

            <div class="relative flex flex-1 flex-col">
              <!-- Icon -->
              <div class="mb-6 flex items-center justify-between">
                <div
                  class:list={[
                    'flex h-12 w-12 items-center justify-center rounded-xl border',
                    isPrimary
                      ? 'border-primary/25 bg-primary/[0.07] text-primary'
                      : isSponsor
                        ? 'border-yellow-400/25 bg-yellow-400/[0.06] text-yellow-300'
                        : 'border-border bg-background-soft/70 text-foreground-muted',
                  ]}
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    class="h-6 w-6"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={iconPaths[item.icon as keyof typeof iconPaths]}
                  />
                </div>

                {index < 2 && (
                  <span
                    class:list={[
                      'rounded-full border px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.1em]',
                      isPrimary
                        ? 'border-primary/25 bg-primary/[0.06] text-primary'
                        : 'border-yellow-400/25 bg-yellow-400/[0.06] text-yellow-300',
                    ]}
                  >
                    {isPrimary ? 'Ayuda directa' : 'Para empresas'}
                  </span>
                )}
              </div>

              <!-- Content -->
              <h3 class="mb-3 font-display text-[24px] leading-tight text-foreground">
                {item.title}
              </h3>

              <p class="mb-6 flex-1 text-sm leading-[1.7] text-foreground-muted">
                {item.description}
              </p>

              <!-- Highlight -->
              <div
                class:list={[
                  'mb-6 rounded-brand-sm border px-4 py-3',
                  isPrimary
                    ? 'border-primary/15 bg-primary/[0.04]'
                    : isSponsor
                      ? 'border-yellow-400/15 bg-yellow-400/[0.035]'
                      : 'border-border bg-white/[0.025]',
                ]}
              >
                <span class="block text-[10px] font-semibold uppercase tracking-[0.1em] text-foreground-subtle">
                  {item.id === 'donar'
                    ? 'Tu aporte'
                    : item.id === 'sponsor'
                      ? 'Niveles disponibles'
                      : 'Podés colaborar'}
                </span>

                <span
                  class:list={[
                    'mt-1 block text-sm font-semibold',
                    isPrimary
                      ? 'text-primary'
                      : isSponsor
                        ? 'text-yellow-300'
                        : 'text-foreground',
                  ]}
                >
                  {item.id === 'donar'
                    ? helpData.donationAlias
                    : item.highlight}
                </span>
              </div>

              <!-- CTA -->
              {item.id === 'share' ? (
                <button
                  type="button"
                  data-share-campaign
                  class="flex w-full items-center justify-center gap-2 rounded-full border border-border bg-white/[0.03] px-5 py-3.5 text-sm font-bold text-foreground transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/35 hover:bg-primary/[0.05] hover:text-primary active:scale-[0.98]"
                >
                  {item.buttonLabel}

                  <svg
                    viewBox="0 0 20 20"
                    fill="none"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 10H16M11 5L16 10L11 15"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              ) : (
                <a
                  href={item.buttonHref}
                  class:list={[
                    'flex w-full items-center justify-center gap-2 rounded-full px-5 py-3.5 text-sm font-bold transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.98]',
                    isPrimary
                      ? 'bg-primary text-white shadow-[0_10px_30px_rgba(224,30,43,0.22)] hover:bg-primary-dark'
                      : isSponsor
                        ? 'bg-yellow-600 text-white shadow-[0_10px_30px_rgba(202,138,4,0.18)] hover:bg-yellow-500'
                        : 'border border-border bg-white/[0.03] text-foreground hover:border-primary/35 hover:bg-primary/[0.05] hover:text-primary',
                  ]}
                >
                  {item.buttonLabel}

                  <svg
                    viewBox="0 0 20 20"
                    fill="none"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 10H16M11 5L16 10L11 15"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <!-- Small bottom note -->
    <div class="mt-8 text-center">
      <p class="text-xs leading-relaxed text-foreground-subtle">
        No importa cuánto puedas aportar: compartir, contratar un servicio o
        acercar una empresa también puede ayudarnos a llegar a España.
      </p>
    </div>
  </div>
</section>

<script define:vars={{ shareText: getShareText() }}>
  const shareButton = document.querySelector('[data-share-campaign]');

  shareButton?.addEventListener('click', async () => {
    const url = window.location.origin;
    const text = decodeURIComponent(shareText);

    if (navigator.share) {
      try {
        await navigator.share({
          title: 'Rumbo a España 2026',
          text,
          url,
        });

        return;
      } catch {
        return;
      }
    }

    const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}`;

    window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
  });
</script>
