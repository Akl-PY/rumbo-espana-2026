---
import { ALIAS } from "../data/config";

const getShareLink = () => {
  const text = encodeURIComponent(
    "¡Hola! Te comparto la campaña Rumbo a España 2026 de la delegación argentina de Taekwondo. Podés sumar tu apoyo o compartirla: https://rumbo-espana-2026.vercel.app",
  );

  return `https://wa.me/?text=${text}`;
};
---

<section id="como-ayudar" class="px-5 py-[88px]">
  <div class="mx-auto max-w-[1100px]">
    <div class="mb-10 text-center">
      <span
        class="mb-3.5 inline-flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.14em] text-primary"
      >
        <span class="h-0.5 w-[22px] bg-primary"></span>
        Participá
      </span>

      <h2
        class="mb-3.5 font-display text-[clamp(28px,6vw,42px)] leading-[1.05] tracking-[-0.01em] text-foreground"
      >
        ¿Cómo podés ayudarnos?
      </h2>

      <p
        class="mx-auto max-w-[560px] text-base leading-relaxed text-foreground-muted"
      >
        Hay muchas formas de ser parte de este sueño mundialista. Elegí la que
        mejor se adapte a vos o a tu empresa.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Donar -->
      <div
        class="group flex flex-col rounded-brand border border-border bg-card p-6 text-center shadow-card transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-white/[0.18] hover:shadow-card-lg"
      >
        <div class="mb-4 text-[2.5rem] leading-none">❤️</div>

        <h3 class="mb-3 font-display text-xl text-foreground">
          Donar
        </h3>

        <p class="mb-6 flex-grow text-sm leading-relaxed text-foreground-muted">
          Aportá el monto que puedas desde cualquier billetera virtual o cuenta
          bancaria.
        </p>

        <div
          class="mb-6 rounded-brand-sm border border-border bg-white/[0.04] px-3 py-2 text-sm text-foreground-muted"
        >
          <span>Alias:</span>
          <strong class="ml-1 font-bold text-accent">{ALIAS}</strong>
        </div>

        <a
          href="#donar"
          class="w-full rounded-brand-sm border border-border bg-white/[0.04] px-4 py-3 text-sm font-bold text-foreground transition-all duration-200 hover:border-white/25 hover:bg-white/[0.08]"
        >
          Ir a Donar
        </a>
      </div>

      <!-- Sponsor -->
      <div
        class="group flex flex-col rounded-brand border border-primary/35 bg-card p-6 text-center shadow-card transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-primary/60 hover:shadow-card-lg"
      >
        <div class="mb-4 text-[2.5rem] leading-none">🤝</div>

        <h3 class="mb-3 font-display text-xl text-foreground">
          Ser Sponsor
        </h3>

        <p class="mb-6 flex-grow text-sm leading-relaxed text-foreground-muted">
          Impulsá tu marca junto a nuestra delegación con paquetes pensados para
          comercios.
        </p>

        <div
          class="mb-6 rounded-brand-sm border border-border bg-white/[0.04] px-3 py-2 text-sm text-foreground-muted"
        >
          <span class="font-bold text-primary">$50.000</span>
          ·
          <span class="font-bold text-primary">$100.000</span>
          ·
          <span class="font-bold text-primary">$150.000</span>
        </div>

        <a
          href="#convertite-en-sponsor"
          class="w-full rounded-brand-sm bg-primary px-4 py-3 text-sm font-bold text-white shadow-[0_8px_24px_rgba(224,30,43,0.25)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-dark"
        >
          Ver Paquetes
        </a>
      </div>

      <!-- Servicios -->
      <div
        class="group flex flex-col rounded-brand border border-border bg-card p-6 text-center shadow-card transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-white/[0.18] hover:shadow-card-lg"
      >
        <div class="mb-4 text-[2.5rem] leading-none">💼</div>

        <h3 class="mb-3 font-display text-xl text-foreground">
          Nuestros Servicios
        </h3>

        <p class="mb-6 flex-grow text-sm leading-relaxed text-foreground-muted">
          Contratá o colaborá con alguno de nuestros emprendimientos y servicios
          profesionales.
        </p>

        <div
          class="mb-6 rounded-brand-sm border border-border bg-white/[0.04] px-3 py-2 text-sm text-foreground-muted"
        >
          Tecnología · Diseño · Taekwondo
        </div>

        <a
          href="#nuestros-proyectos"
          class="w-full rounded-brand-sm border border-border bg-white/[0.04] px-4 py-3 text-sm font-bold text-foreground transition-all duration-200 hover:border-white/25 hover:bg-white/[0.08]"
        >
          Ver Proyectos
        </a>
      </div>

      <!-- Compartir -->
      <div
        class="group flex flex-col rounded-brand border border-border bg-card p-6 text-center shadow-card transition-all duration-300 ease-brand hover:-translate-y-1 hover:border-white/[0.18] hover:shadow-card-lg"
      >
        <div class="mb-4 text-[2.5rem] leading-none">📣</div>

        <h3 class="mb-3 font-display text-xl text-foreground">
          Compartir
        </h3>

        <p class="mb-6 flex-grow text-sm leading-relaxed text-foreground-muted">
          Ayudanos haciendo correr la voz entre amigos, familiares o en tus
          redes sociales.
        </p>

        <div
          class="mb-6 rounded-brand-sm border border-border bg-white/[0.04] px-3 py-2 text-sm text-foreground-muted"
        >
          Difusión gratuita
        </div>

        <a
          href={getShareLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full rounded-brand-sm border border-border bg-white/[0.04] px-4 py-3 text-sm font-bold text-foreground transition-all duration-200 hover:border-white/25 hover:bg-white/[0.08]"
        >
          Difundir por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>