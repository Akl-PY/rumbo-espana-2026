---
import storyData from '../data/story.json';

const story = storyData.events ?? [];
---

<section id="historia" class="relative overflow-hidden px-5 py-[88px]">
  <div class="mx-auto max-w-[1100px]">
    <!-- Header -->
    <div class="mb-16">
      <p class="mb-3.5 inline-flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.14em] text-primary">
        <span class="h-0.5 w-[22px] bg-primary"></span>
        Nuestra historia
      </p>

      <h2 class="font-display text-[clamp(28px,6vw,42px)] leading-[1.05] tracking-[-0.01em] text-foreground">
        El camino hasta acá
      </h2>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Línea -->
      <div class="absolute bottom-0 left-[18px] top-0 w-[2px] bg-primary/20 lg:left-1/2 lg:-translate-x-1/2"></div>

      <div class="absolute left-[18px] top-0 h-full w-[2px] bg-primary lg:left-1/2 lg:-translate-x-1/2"></div>

      <div class="space-y-14 lg:space-y-20">
        {story.map((item, index) => {
          const isLeft = index % 2 === 0;

          return (
            <article class="relative grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
              <!-- Nodo -->
              <div class="absolute left-[10px] z-10 h-[18px] w-[18px] rounded-full border-[3px] border-background bg-primary shadow-[0_0_0_4px_rgba(220,38,38,0.12)] lg:left-1/2 lg:-translate-x-1/2"></div>

              <!-- Contenido -->
              <div
                class:list={[
                  'ml-12 lg:ml-0',
                  isLeft ? 'lg:pr-16' : 'lg:col-start-2 lg:pl-16',
                ]}
              >
                <div class="rounded-brand border border-border bg-background/80 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/40">
                  <!-- Fecha -->
                  <div class="mb-3 flex items-center gap-3">
                    <span class="font-display text-[14px] font-bold uppercase tracking-[0.12em] text-primary">
                      {item.date}
                    </span>

                    <span class="h-px flex-1 bg-border"></span>
                  </div>

                  <!-- Título -->
                  <h3 class="mb-3 font-display text-[24px] leading-tight text-foreground">
                    {item.title}
                  </h3>

                  <!-- Descripción -->
                  <p class="text-[16px] leading-[1.7] text-foreground-muted">
                    {item.description}
                  </p>

                  <!-- Imagen -->
                  {item.image && (
                    <div class="mt-5 overflow-hidden rounded-brand border border-border">
                      <img
                        src={item.image}
                        alt={item.title}
                        loading="lazy"
                        class="h-auto w-full object-cover transition-transform duration-500 hover:scale-[1.02]"
                      />
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>
