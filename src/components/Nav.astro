<header class="nav-header">
  <div class="nav-container">
    <a href="#" class="nav-brand">Rumbo a España 2026 🇪🇸</a>
    
    <nav class="nav-menu">
      <a href="#como-ayudar">Cómo Ayudar</a>
      <a href="#convertite-en-sponsor">Sponsors</a>
      <a href="#nuestros-proyectos">Proyectos</a>
      <a href="#donar" class="nav-cta">Donar</a>
    </nav>
  </div>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 17, 32, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-brand {
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    font-size: 1rem;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-menu a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .nav-menu a:hover {
    color: #fff;
  }

  .nav-cta {
    background: #2563eb;
    color: #fff !important;
    padding: 0.4rem 0.9rem;
    border-radius: 0.375rem;
  }

  .nav-cta:hover {
    background: #1d4ed8;
  }

  @media (max-width: 640px) {
    .nav-menu a:not(.nav-cta) {
      display: none;
    }
  }
</style>
