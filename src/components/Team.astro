---
import { TEAM } from "../data/config";
---

<section id="delegacion">
  <div class="container">
    <p class="eyebrow reveal">Quiénes somos</p>
    <h2 class="reveal">Nuestra delegación</h2>
    <p class="section-lead reveal">
      Competidores y coaches que representan a Argentina en Benidorm.
    </p>

    <div class="team-grid">
      {
        TEAM.map((member) => (
          <div class="card team-card reveal">
            <div class="img-frame team-photo">
              <img
                src={member.image}
                alt={member.name}
                loading="lazy"
                onload="this.classList.add('is-loaded')"
                onerror="this.remove()"
              />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c1.5-4.5 5-6 8-6s6.5 1.5 8 6" />
              </svg>
            </div>
            <div class="team-info">
              <div class="team-name">{member.name}</div>
              <div class="team-role">{member.role}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
