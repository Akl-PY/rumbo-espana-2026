---
import { GALLERY_PATH, GALLERY_MAX_ITEMS } from "../data/config";
---

<section id="galeria">
  <div class="container">
    <p class="eyebrow reveal">Momentos</p>
    <h2 class="reveal">Galería</h2>
    <p class="section-lead reveal">
      Entrenamientos, competencias y preparación rumbo a Benidorm.
    </p>

    <div
      class="gallery-grid"
      id="gallery-grid"
      data-base={GALLERY_PATH}
      data-max={GALLERY_MAX_ITEMS}
    >
    </div>
    <p class="gallery-empty" id="gallery-empty" style="display: none;">
      Todavía no hay fotos cargadas en la galería. Vas a poder agregarlas
      subiendo archivos a <code>/public/images/gallery/</code>.
    </p>
  </div>
</section>

<script>
  function initGallery() {
    const grid = document.getElementById("gallery-grid");
    const empty = document.getElementById("gallery-empty");
    if (!grid) return;

    const base = grid.dataset.base || "/images/gallery";
    const max = Number(grid.dataset.max || 6);
    let found = 0;
    let checked = 0;

    for (let i = 1; i <= max; i++) {
      const src = `${base}/gallery-${i}.jpg`;
      const probe = new Image();

      probe.onload = () => {
        found++;
        checked++;

        const item = document.createElement("div");
        item.className = "gallery-item";

        const img = document.createElement("img");
        img.src = src;
        img.alt = `Foto ${i} de la delegación`;
        img.loading = "lazy";

        item.appendChild(img);
        grid.appendChild(item);

        // Pequeño delay para que la animación de aparición se note.
        requestAnimationFrame(() => {
          setTimeout(() => item.classList.add("is-loaded"), 30);
        });

        checkDone();
      };

      probe.onerror = () => {
        checked++;
        checkDone();
      };

      probe.src = src;
    }

    function checkDone() {
      if (checked === max && found === 0 && empty) {
        empty.style.display = "block";
      }
    }
  }

  initGallery();
</script>
