---
import galleryData from '../data/gallery.json';

const items = galleryData.items ?? [];

const galleryItems = items.map((item, index) => ({
  ...item,
  index,
}));
---

<section id="galeria" class="relative overflow-hidden px-5 py-[88px]">
  <div class="mx-auto max-w-[1100px]">
    <!-- Header -->
    <div class="mb-12">
      <span class="mb-3.5 inline-flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.14em] text-primary">
        <span class="h-0.5 w-[22px] bg-primary"></span>
        {galleryData.eyebrow}
      </span>

      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="font-display text-[clamp(30px,6vw,46px)] leading-[1.02] tracking-[-0.015em] text-foreground">
            {galleryData.title}
          </h2>

          <p class="mt-3 max-w-[650px] text-base leading-[1.75] text-foreground-muted">
            {galleryData.description}
          </p>
        </div>

        {items.length > 0 && (
          <div class="shrink-0 rounded-full border border-border bg-background-soft/60 px-3.5 py-2 text-[10px] font-bold uppercase tracking-[0.1em] text-foreground-subtle">
            {items.length} {items.length === 1 ? 'momento' : 'momentos'}
          </div>
        )}
      </div>
    </div>

    {galleryItems.length > 0 ? (
      <div id="gallery-grid" class="gallery-columns">
        {galleryItems.map((item) => (
          <button
            type="button"
            data-gallery-index={item.index}
            class:list={[
              'gallery-item group relative mb-4 block w-full overflow-hidden rounded-[20px] border border-border bg-card text-left shadow-card',
              'break-inside-avoid',
              'transition-all duration-500 ease-brand',
              'hover:-translate-y-1 hover:border-primary/30 hover:shadow-card-lg',
              item.featured ? 'gallery-featured' : '',
            ]}
            aria-label={`Abrir ${item.title}`}
          >
            <div class="relative overflow-hidden">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="gallery-image block h-auto w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              />

              <!-- Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-90"></div>

              <!-- Shine -->
              <div
                class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                style="background: linear-gradient(120deg, transparent 25%, rgba(255,255,255,0.10) 50%, transparent 75%);"
              ></div>

              <!-- Content -->
              <div class="absolute inset-x-0 bottom-0 p-5">
                <div class="mb-2 h-[2px] w-8 bg-primary transition-all duration-300 group-hover:w-14"></div>

                <h3 class="font-display text-lg leading-tight text-white">
                  {item.title}
                </h3>

                {item.description && (
                  <p class="mt-1.5 max-w-[90%] text-xs leading-relaxed text-white/70">
                    {item.description}
                  </p>
                )}
              </div>

              <!-- Expand -->
              <span class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-black/30 text-white/90 opacity-0 backdrop-blur-md transition-all duration-300 group-hover:opacity-100">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path
                    d="M7 3H3V7M13 3H17V7M17 13V17H13M3 13V17H7"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </div>
          </button>
        ))}
      </div>
    ) : (
      <div class="rounded-[24px] border border-dashed border-border px-5 py-16 text-center">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          class="mx-auto mb-4 h-10 w-10 text-foreground-subtle"
          aria-hidden="true"
        >
          <rect
            x="3"
            y="4"
            width="18"
            height="16"
            rx="2"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <circle
            cx="8.5"
            cy="9"
            r="1.5"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path
            d="M4 17L9 12L13 16L16 13L20 17"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

        <p class="text-sm text-foreground-muted">
          Todavía no hay fotos cargadas en la galería.
        </p>
      </div>
    )}
  </div>
</section>

<!-- ============================================================
     LIGHTBOX
     ============================================================ -->

<div
  id="gallery-modal"
  class="fixed inset-0 z-[1200] hidden items-center justify-center bg-black/90 p-4 backdrop-blur-md"
  aria-hidden="true"
>
  <div
    id="gallery-panel"
    class="relative flex max-h-[92vh] w-full max-w-6xl flex-col overflow-hidden rounded-[24px] border border-white/10 bg-black/40 shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="gallery-modal-title"
  >
    <!-- Close -->
    <button
      type="button"
      data-gallery-close
      aria-label="Cerrar galería"
      class="absolute right-4 top-4 z-20 flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-black/40 text-white backdrop-blur-md transition hover:border-white/30 hover:bg-black/60"
    >
      <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" aria-hidden="true">
        <path
          d="M5 5L15 15M15 5L5 15"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
    </button>

    <!-- Previous -->
    <button
      type="button"
      data-gallery-prev
      aria-label="Imagen anterior"
      class="absolute left-4 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/40 text-white backdrop-blur-md transition hover:border-white/30 hover:bg-black/60"
    >
      <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true">
        <path
          d="M12 4L6 10L12 16"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <!-- Next -->
    <button
      type="button"
      data-gallery-next
      aria-label="Imagen siguiente"
      class="absolute right-4 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/40 text-white backdrop-blur-md transition hover:border-white/30 hover:bg-black/60"
    >
      <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true">
        <path
          d="M8 4L14 10L8 16"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <!-- Image -->
    <div class="flex min-h-0 flex-1 items-center justify-center p-4 sm:p-8">
      <img
        id="gallery-modal-image"
        src=""
        alt=""
        class="max-h-[72vh] max-w-full rounded-xl object-contain"
      />
    </div>

    <!-- Info -->
    <div class="border-t border-white/10 bg-black/35 px-5 py-4 backdrop-blur-md sm:px-7">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h3
            id="gallery-modal-title"
            class="font-display text-xl text-white"
          ></h3>

          <p
            id="gallery-modal-description"
            class="mt-1 text-sm text-white/60"
          ></p>
        </div>

        <span
          id="gallery-modal-counter"
          class="shrink-0 text-[10px] font-bold uppercase tracking-[0.1em] text-white/40"
        ></span>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ galleryItems }}>
  const items = galleryItems;

  const modal = document.querySelector('#gallery-modal');
  const panel = document.querySelector('#gallery-panel');

  const modalImage = document.querySelector('#gallery-modal-image');

  const modalTitle = document.querySelector('#gallery-modal-title');

  const modalDescription = document.querySelector('#gallery-modal-description');

  const modalCounter = document.querySelector('#gallery-modal-counter');

  const closeButton = document.querySelector('[data-gallery-close]');

  const prevButton = document.querySelector('[data-gallery-prev]');

  const nextButton = document.querySelector('[data-gallery-next]');

  const galleryButtons = document.querySelectorAll('[data-gallery-index]');

  let currentIndex = 0;

  const openModal = () => {
    if (!modal || !panel) return;

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    modal.setAttribute('aria-hidden', 'false');

    document.body.classList.add('overflow-hidden');

    requestAnimationFrame(() => {
      panel.classList.remove('translate-y-2', 'opacity-0');
    });
  };

  const closeModal = () => {
    if (!modal || !panel) return;

    panel.classList.add('translate-y-2', 'opacity-0');

    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');

      modal.setAttribute('aria-hidden', 'true');

      document.body.classList.remove('overflow-hidden');
    }, 200);
  };

  const renderImage = (index) => {
    if (!items.length) return;

    currentIndex = (index + items.length) % items.length;

    const item = items[currentIndex];

    if (modalImage) {
      modalImage.src = item.image;
      modalImage.alt = item.title;
    }

    if (modalTitle) {
      modalTitle.textContent = item.title;
    }

    if (modalDescription) {
      modalDescription.textContent = item.description || '';
    }

    if (modalCounter) {
      modalCounter.textContent = `${currentIndex + 1} / ${items.length}`;
    }
  };

  const openAt = (index) => {
    renderImage(index);
    openModal();
  };

  galleryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const index = Number(button.getAttribute('data-gallery-index'));

      openAt(index);
    });
  });

  closeButton?.addEventListener('click', closeModal);

  prevButton?.addEventListener('click', () => {
    renderImage(currentIndex - 1);
  });

  nextButton?.addEventListener('click', () => {
    renderImage(currentIndex + 1);
  });

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (modal?.classList.contains('hidden')) {
      return;
    }

    if (event.key === 'Escape') {
      closeModal();
    }

    if (event.key === 'ArrowLeft') {
      renderImage(currentIndex - 1);
    }

    if (event.key === 'ArrowRight') {
      renderImage(currentIndex + 1);
    }
  });
</script>

<style>
  .gallery-columns {
    column-count: 2;
    column-gap: 1rem;
  }

  .gallery-item {
    break-inside: avoid;
  }

  .gallery-featured .gallery-image {
    min-height: 360px;
  }

  .gallery-image {
    max-height: 700px;
  }

  @media (min-width: 680px) {
    .gallery-columns {
      column-count: 3;
    }
  }

  @media (max-width: 679px) {
    .gallery-columns {
      column-gap: 0.75rem;
    }

    .gallery-item {
      margin-bottom: 0.75rem;
    }

    .gallery-featured .gallery-image {
      min-height: 260px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-image,
    .gallery-item {
      transition: none !important;
    }
  }
</style>
