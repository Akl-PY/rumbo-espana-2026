---
import projectsData from '../data/projects.json';

const projects = projectsData.items ?? [];

const slugify = (value: string) => {
  return value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
};

const projectsWithSlug = projects.map((project) => ({
  ...project,
  slug: slugify(project.id || project.name),
}));
---

<section
  id="nuestros-proyectos"
  class="relative overflow-hidden px-5 py-[88px]"
>
  <div class="mx-auto max-w-[1100px]">
    <!-- Header -->
    <div class="mx-auto mb-12 max-w-[720px] text-center">
      <span class="mb-3.5 inline-flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.14em] text-primary">
        <span class="h-0.5 w-[22px] bg-primary"></span>
        {projectsData.eyebrow}
      </span>

      <h2 class="mb-4 font-display text-[clamp(30px,6vw,46px)] leading-[1.02] tracking-[-0.015em] text-foreground">
        {projectsData.title}
      </h2>

      <p class="mx-auto max-w-[650px] text-base leading-[1.75] text-foreground-muted">
        {projectsData.description}
      </p>
    </div>

    <!-- Projects -->
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
      {projectsWithSlug.map((project) => {
        const isScalinky = project.id === 'scalinky';

        return (
          <article
            class:list={[
              'group relative flex h-full flex-col overflow-hidden rounded-[24px] border bg-card p-6 shadow-card transition-all duration-300 ease-brand sm:p-7',
              'hover:-translate-y-1 hover:shadow-card-lg',
              isScalinky
                ? 'border-accent/30 hover:border-accent/55'
                : 'border-border hover:border-primary/35',
            ]}
          >
            <!-- Glow -->
            <div
              class:list={[
                'pointer-events-none absolute -right-20 -top-20 h-44 w-44 rounded-full blur-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100',
                isScalinky ? 'bg-accent/10' : 'bg-primary/10',
              ]}
            ></div>

            <!-- Línea decorativa -->
            <div
              class:list={[
                'absolute inset-x-0 top-0 h-[2px]',
                isScalinky ? 'bg-accent' : 'bg-primary',
              ]}
            ></div>

            <div class="relative flex flex-1 flex-col">
              <!-- Header proyecto -->
              <div class="mb-6 flex items-start justify-between gap-4">
                <div class="flex items-center gap-3.5">
                  <div
                    class:list={[
                      'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border text-2xl',
                      isScalinky
                        ? 'border-accent/20 bg-accent/[0.05]'
                        : 'border-primary/20 bg-primary/[0.05]',
                    ]}
                  >
                    {project.badge}
                  </div>

                  <div>
                    <h3 class="font-display text-[23px] leading-tight text-foreground">
                      {project.name}
                    </h3>

                    <span
                      class:list={[
                        'mt-1 block text-xs font-semibold',
                        isScalinky ? 'text-accent' : 'text-primary',
                      ]}
                    >
                      {project.tagline}
                    </span>
                  </div>
                </div>

                <!-- Compartir -->
                <button
                  type="button"
                  data-share-project={project.slug}
                  aria-label={`Compartir ${project.name}`}
                  class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border text-foreground-muted transition-all duration-200 hover:border-primary/40 hover:bg-primary/[0.05] hover:text-primary"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <circle
                      cx="18"
                      cy="5"
                      r="2.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                    />
                    <circle
                      cx="6"
                      cy="12"
                      r="2.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                    />
                    <circle
                      cx="18"
                      cy="19"
                      r="2.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                    />
                    <path
                      d="M8.2 10.8L15.8 6.2M8.2 13.2L15.8 17.8"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
              </div>

              <!-- Descripción -->
              <p class="mb-6 text-[15px] leading-[1.75] text-foreground-muted">
                {project.description}
              </p>

              <!-- Formas de colaborar -->
              <div class="mb-6 rounded-brand-sm border border-border bg-background-soft/50 p-4">
                <span class="mb-3 block text-[10px] font-bold uppercase tracking-[0.1em] text-foreground-subtle">
                  Podés colaborar mediante
                </span>

                <ul class="space-y-2.5">
                  {project.collaborations.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-foreground-muted">
                      <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Acciones -->
              <div class="mt-auto grid grid-cols-1 gap-2.5 sm:grid-cols-[1fr_auto]">
                <!-- Enlace principal -->
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'flex items-center justify-center gap-2 rounded-full px-5 py-3.5 text-sm font-bold transition-all duration-200',
                    'hover:-translate-y-0.5 active:scale-[0.98]',
                    isScalinky
                      ? 'bg-accent text-background shadow-[0_10px_30px_rgba(0,0,0,0.15)] hover:brightness-110'
                      : 'bg-primary text-white shadow-[0_10px_30px_rgba(224,30,43,0.20)] hover:bg-primary-dark',
                  ]}
                >
                  {project.ctaText}

                  <svg
                    viewBox="0 0 20 20"
                    fill="none"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 10H16M11 5L16 10L11 15"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>

                <!-- Compartir -->
                <button
                  type="button"
                  data-share-project={project.slug}
                  class="inline-flex items-center justify-center gap-2 rounded-full border border-border bg-white/[0.02] px-5 py-3.5 text-sm font-semibold text-foreground transition-all duration-200 hover:border-primary/35 hover:bg-primary/[0.05] hover:text-primary"
                >
                  Compartir
                  <svg
                    viewBox="0 0 20 20"
                    fill="none"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <path
                      d="M7 10L13 6M7 10L13 14"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                    <circle
                      cx="5"
                      cy="10"
                      r="2"
                      stroke="currentColor"
                      stroke-width="1.6"
                    />
                    <circle
                      cx="15"
                      cy="5"
                      r="2"
                      stroke="currentColor"
                      stroke-width="1.6"
                    />
                    <circle
                      cx="15"
                      cy="15"
                      r="2"
                      stroke="currentColor"
                      stroke-width="1.6"
                    />
                  </svg>
                </button>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- ============================================================
     MODAL COMPARTIR
     ============================================================ -->

<div
  id="project-share-modal"
  class="fixed inset-0 z-[1100] hidden items-end justify-center bg-black/75 p-4 backdrop-blur-sm sm:items-center"
  aria-hidden="true"
>
  <div
    id="project-share-panel"
    class="w-full max-w-md translate-y-6 rounded-[28px] border border-border bg-card p-6 opacity-0 shadow-2xl transition-all duration-300 sm:translate-y-0"
    role="dialog"
    aria-modal="true"
    aria-labelledby="project-share-title"
  >
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <span class="mb-2 block text-[10px] font-bold uppercase tracking-[0.12em] text-primary">
          Compartir
        </span>

        <h3
          id="project-share-title"
          class="font-display text-2xl leading-tight text-foreground"
        >
          Compartir proyecto
        </h3>
      </div>

      <button
        type="button"
        data-close-project-share
        aria-label="Cerrar"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border text-foreground-muted transition hover:border-primary/40 hover:text-primary"
      >
        <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" aria-hidden="true">
          <path
            d="M5 5L15 15M15 5L5 15"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>

    <!-- Proyecto -->
    <div class="mb-5 rounded-brand-sm border border-border bg-background-soft/60 p-4">
      <span class="block text-xs text-foreground-muted">
        Estás compartiendo
      </span>

      <strong
        id="project-share-name"
        class="mt-1 block font-display text-lg text-foreground"
      ></strong>
    </div>

    <!-- Texto -->
    <div class="mb-5 rounded-brand-sm border border-border bg-white/[0.02] p-4">
      <p
        id="project-share-text"
        class="text-sm leading-relaxed text-foreground-muted"
      ></p>
    </div>

    <!-- Botones -->
    <div class="grid grid-cols-2 gap-3">
      <button
        type="button"
        data-project-share-native
        class="col-span-2 flex items-center justify-center gap-2 rounded-brand-sm bg-primary px-4 py-3 text-sm font-semibold text-white transition hover:bg-primary-dark"
      >
        Compartir
      </button>

      <a
        id="project-share-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center rounded-brand-sm border border-border px-4 py-3 text-sm font-medium text-foreground transition hover:border-primary/40 hover:bg-primary/[0.05]"
      >
        WhatsApp
      </a>

      <a
        id="project-share-telegram"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center rounded-brand-sm border border-border px-4 py-3 text-sm font-medium text-foreground transition hover:border-primary/40 hover:bg-primary/[0.05]"
      >
        Telegram
      </a>

      <button
        type="button"
        data-copy-project-share
        class="col-span-2 flex items-center justify-center gap-2 rounded-brand-sm border border-border px-4 py-3 text-sm font-medium text-foreground transition hover:border-primary/40 hover:bg-primary/[0.05]"
      >
        Copiar texto y enlace
      </button>
    </div>
  </div>
</div>

<script define:vars={{ projects: projectsWithSlug }}>
  const shareModal = document.querySelector('#project-share-modal');
  const sharePanel = document.querySelector('#project-share-panel');

  const shareName = document.querySelector('#project-share-name');
  const shareTextElement = document.querySelector('#project-share-text');

  const shareWhatsapp = document.querySelector('#project-share-whatsapp');
  const shareTelegram = document.querySelector('#project-share-telegram');

  const closeButton = document.querySelector('[data-close-project-share]');

  const nativeShareButton = document.querySelector(
    '[data-project-share-native]',
  );

  const copyButton = document.querySelector('[data-copy-project-share]');

  let currentProject = null;
  let currentUrl = '';
  let currentText = '';

  const openModal = () => {
    if (!shareModal || !sharePanel) return;

    shareModal.classList.remove('hidden');
    shareModal.classList.add('flex');
    shareModal.setAttribute('aria-hidden', 'false');

    document.body.classList.add('overflow-hidden');

    requestAnimationFrame(() => {
      sharePanel.classList.remove('translate-y-6', 'opacity-0');
    });
  };

  const closeModal = () => {
    if (!shareModal || !sharePanel) return;

    sharePanel.classList.add('translate-y-6', 'opacity-0');

    setTimeout(() => {
      shareModal.classList.add('hidden');
      shareModal.classList.remove('flex');

      shareModal.setAttribute('aria-hidden', 'true');

      document.body.classList.remove('overflow-hidden');
    }, 250);
  };

  const buildUrl = (project) => {
    const url = new URL(window.location.href);

    url.search = '';
    url.hash = '';

    url.searchParams.set('project', project.slug);

    return url.toString();
  };

  const openShare = (slug) => {
    const project = projects.find((item) => item.slug === slug);

    if (!project) return;

    currentProject = project;
    currentUrl = buildUrl(project);
    currentText = project.shareText;

    if (shareName) {
      shareName.textContent = project.name;
    }

    if (shareTextElement) {
      shareTextElement.textContent = project.shareText;
    }

    if (shareWhatsapp) {
      shareWhatsapp.setAttribute(
        'href',
        `https://wa.me/?text=${encodeURIComponent(
          `${project.shareText}\n${currentUrl}`,
        )}`,
      );
    }

    if (shareTelegram) {
      shareTelegram.setAttribute(
        'href',
        `https://t.me/share/url?url=${encodeURIComponent(
          currentUrl,
        )}&text=${encodeURIComponent(project.shareText)}`,
      );
    }

    openModal();
  };

  document.querySelectorAll('[data-share-project]').forEach((button) => {
    button.addEventListener('click', () => {
      const slug = button.dataset.shareProject;

      if (slug) {
        openShare(slug);
      }
    });
  });

  closeButton?.addEventListener('click', closeModal);

  shareModal?.addEventListener('click', (event) => {
    if (event.target === shareModal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !shareModal?.classList.contains('hidden')) {
      closeModal();
    }
  });

  nativeShareButton?.addEventListener('click', async () => {
    if (!currentProject || !currentUrl) {
      return;
    }

    if (navigator.share) {
      try {
        await navigator.share({
          title: `${currentProject.name} · Rumbo a España 2026`,
          text: currentText,
          url: currentUrl,
        });
      } catch {
        // El usuario cerró el selector nativo.
      }

      return;
    }

    try {
      await navigator.clipboard.writeText(`${currentText}\n${currentUrl}`);

      nativeShareButton.textContent = '✓ Copiado';

      setTimeout(() => {
        nativeShareButton.textContent = 'Compartir';
      }, 1800);
    } catch {
      // Clipboard no disponible.
    }
  });

  copyButton?.addEventListener('click', async () => {
    if (!currentUrl) return;

    try {
      await navigator.clipboard.writeText(`${currentText}\n${currentUrl}`);

      copyButton.textContent = '✓ Texto y enlace copiados';

      setTimeout(() => {
        copyButton.textContent = 'Copiar texto y enlace';
      }, 1800);
    } catch {
      copyButton.textContent = 'No se pudo copiar';

      setTimeout(() => {
        copyButton.textContent = 'Copiar texto y enlace';
      }, 1800);
    }
  });

  /*
   * Abrir automáticamente el modal cuando
   * alguien comparte:
   *
   * ?project=scalinky
   */
  const projectFromUrl = new URLSearchParams(window.location.search).get(
    'project',
  );

  if (projectFromUrl) {
    requestAnimationFrame(() => {
      openShare(projectFromUrl);
    });
  }
</script>
