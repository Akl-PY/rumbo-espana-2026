---
import Layout from '../layouts/Layout.astro';

import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Goal from '../components/Goal.astro';
import HowToDonate from '../components/HowToDonate.astro';
import Donations from '../components/Donations.astro';
import Transparency from '../components/Transparency.astro';
import CurrentSponsors from '../components/​CurrentSponsors.astro';
import BecomeSponsor from '../components/BecomeSponsor.astro';
import HowToHelp from '../components/​HowToHelp.astro';
import Projects from '../components/​Projects.astro';
import CommercialCollab from '../components/CommercialCollab.astro';
import Team from '../components/Team.astro';
import Gallery from '../components/Gallery.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
---

<Layout>
  <Nav />

  <main class="relative min-h-screen overflow-hidden bg-background">
    <!--
      ============================================================
      DECORATIVE CIRCUIT
      ============================================================
    -->

    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <!-- Glow ambiental -->
      <div
        class="absolute left-1/2 top-[20%] h-[500px] w-[500px]
        -translate-x-1/2 rounded-full bg-primary/5 blur-[140px]"
      ></div>

      <svg
        class="absolute inset-0 h-full w-full"
        viewBox="0 0 1440 4200"
        preserveAspectRatio="none"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- =====================================================
             CAMINO PRINCIPAL IZQUIERDO
             ===================================================== -->

        <path
          d="
            M -100 180
            H 180
            L 260 260
            H 520
            L 610 350
            V 620
            L 690 700
            H 830
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.28"
        ></path>

        <!-- Camino paralelo -->
        <path
          d="
            M -80 230
            H 150
            L 230 310
            H 470
            L 550 390
            V 650
          "
          stroke="var(--color-primary)"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.12"
        ></path>

        <!-- =====================================================
             RAMIFICACIÓN SUPERIOR
             ===================================================== -->

        <path
          d="
            M 260 260
            V 90
            H 510
            L 590 10
