        <path
          d="
            M -80 1000
            H 150
            L 210 1060
            V 1200
          "
          stroke="var(--color-primary)"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.10"
        ></path>

        <!-- =====================================================
             CRUCE CENTRAL
             ===================================================== -->

        <path
          d="
            M 570 1120
            H 800
            L 880 1200
            V 1430
            L 960 1510
            H 1210
            L 1290 1590
