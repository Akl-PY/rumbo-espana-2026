          opacity="0.20"
        ></path>

        <!-- =====================================================
             PARTE INFERIOR MEDIA
             ===================================================== -->

        <path
          d="
            M -100 1650
            H 200
            L 280 1730
            H 500
            L 580 1810
            V 2020
            L 660 2100
            H 900
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.22"
        ></path>

        <!-- Bifurcación -->
        <path
          d="
            M 500 1730
            V 1530
            L 580 1450
            H 760
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.16"
        ></path>

        <!-- =====================================================
             GRAN CAMINO DIAGONAL
             ===================================================== -->

        <path
          d="
            M 1540 1900
            H 1280
            L 1200 1980
            V 2200
            L 1120 2280
            H 900
            L 820 2360
            V 2580
