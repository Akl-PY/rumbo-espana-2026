---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Goal from "../components/Goal.astro";
import Donations from "../components/Donations.astro";
import HowToDonate from "../components/HowToDonate.astro";
import Team from "../components/Team.astro";
import Story from "../components/Story.astro";
import Gallery from "../components/Gallery.astro";
import CTAFinal from "../components/CTAFinal.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Goal />
    <Donations />
    <HowToDonate />
    <Team />
    <Story />
    <Gallery />
    <CTAFinal />
  </main>
  <Footer />
</Layout>

<script>
  // Animación de aparición al hacer scroll para todos los .reveal
  function initReveal() {
    const items = document.querySelectorAll(".reveal");
    if (!items.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  }

  initReveal();
</script>
