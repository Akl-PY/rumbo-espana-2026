          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.20"
        ></path>

        <path
          d="
            M 510 90
            L 600 180
            H 880
            L 970 270
            V 450
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.18"
        ></path>

        <!-- =====================================================
             CAMINO SUPERIOR DERECHO
             ===================================================== -->

        <path
          d="
            M 1500 120
            H 1240
            L 1160 200
            H 970
            L 900 270
            V 520
            L 820 600
            H 650
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.25"
        ></path>

        <path
          d="
            M 1500 170
            H 1270
            L 1190 250
            H 1010
            L 940 320
            V 480
          "
          stroke="var(--color-primary)"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.12"
        ></path>

        <!-- =====================================================
             NODO CENTRAL
             ===================================================== -->

        <path
          d="
            M 830 700
            L 910 780
            H 1100
            L 1180 860
            V 1110
            L 1260 1190
            H 1500
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.22"
        ></path>

        <!-- Ramificación -->
        <path
