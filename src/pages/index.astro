            V 3380
            L 1140 3460
            H 1500
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.24"
        ></path>

        <!-- Ramificación inferior -->
        <path
          d="
            M 980 3080
            V 2890
            L 1060 2810
            H 1260
          "
          stroke="var(--color-primary)"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.15"
        ></path>

        <!-- =====================================================
             ÚLTIMO TRAMO
             ===================================================== -->

        <path
          d="
            M -100 3200
            H 180
            L 260 3280
            H 480
            L 560 3360
            V 3560
            L 640 3640
            H 850
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.18"
        ></path>

        <path
          d="
            M 1540 3500
            H 1280
            L 1200 3580
            H 980
            L 900 3660
            V 3890
          "
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.22"
        ></path>

        <!-- =====================================================
             NODOS
             ===================================================== -->

        <g fill="var(--color-primary)">
          <circle cx="260" cy="260" r="4" opacity="0.55"></circle>
          <circle cx="610" cy="350" r="3" opacity="0.45"></circle>
          <circle cx="910" cy="780" r="4" opacity="0.50"></circle>
          <circle cx="570" cy="1120" r="3" opacity="0.45"></circle>
          <circle cx="1180" cy="860" r="3" opacity="0.40"></circle>
          <circle cx="880" cy="1200" r="4" opacity="0.50"></circle>
          <circle cx="500" cy="1730" r="3" opacity="0.40"></circle>
          <circle cx="1200" cy="1980" r="4" opacity="0.50"></circle>
          <circle cx="820" cy="2360" r="3" opacity="0.40"></circle>
          <circle cx="730" cy="3080" r="4" opacity="0.50"></circle>
          <circle cx="1060" cy="3160" r="3" opacity="0.40"></circle>
        </g>

        <!-- Pequeños halos de nodos -->
        <g fill="var(--color-primary)" opacity="0.08">
          <circle cx="260" cy="260" r="14"></circle>
          <circle cx="910" cy="780" r="16"></circle>
          <circle cx="880" cy="1200" r="14"></circle>
          <circle cx="1200" cy="1980" r="16"></circle>
          <circle cx="730" cy="3080" r="16"></circle>
        </g>
      </svg>

      <!-- Degradado para que el patrón desaparezca suavemente -->
      <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_60%,var(--color-background)_100%)]"></div>
    </div>

    <!--
      ============================================================
      CONTENIDO
      ============================================================
    -->

    <div class="relative z-10">
      <!-- 1. Impacto inicial -->
      <Hero />

      <!-- 2. Motivo emocional -->
      <Story />

      <!-- 3. Objetivo económico -->
      <Goal />

      <!-- 4. Explicación rápida para donar -->
      <HowToDonate />

      <!-- 5. CONVERSIÓN PRINCIPAL -->
      <Donations />

      <!-- 6. Confianza después de pedir dinero -->
      <Transparency />

      <!-- 7. Prueba social -->
      <CurrentSponsors />

      <!-- 8. SEGUNDO OBJETIVO: SPONSORS -->
      <BecomeSponsor />

      <!-- 9. Otras formas de ayudar -->
      <HowToHelp />

      <!-- 10. En qué se utilizará el dinero -->
      <Projects />

      <!-- 12. Quiénes participan -->
      <Team />

      <!-- 13. Evidencia visual -->
      <Gallery />

      <!-- 14. Última llamada a la acción -->
      <CTAFinal />

      <Footer />
    </div>
